/*
 * UXP version of export-regions.jsx (InDesign UXP scripting; run from the Scripts panel or UXP Script Editor).
 * Exports brochure dynamic-region geometry and text styles to <document>.regions.json
 *
 * Setup in InDesign (one scaffold page per template: cover, content, back):
 *  - Put one frame (rectangle or text frame) per dynamic region on the layer named in GUIDE_LAYER.
 *    Static artwork (logo, QR code, fixed text) stays on normal layers and is NOT exported.
 *  - Name each frame in Window > Utilities > Script Label.
 *      cover:   productDescription, productPartNumber, productHero
 *      content: cell.1 ... cell.4 (reading order: left-to-right, top-to-bottom)
 *  - Label any frame (on any layer) on each page, or on its master/parent page, "template:cover",
 *    "template:content" or "template:back". A label on the page wins over its master's. The separator
 *    must be a colon (a dot or = also works). If a single-page document is named
 *    Cover.indd, Content.indd or Back.indd, the file name is used when there is no label.
 *  - The template-labelled frame is also exported as "templateFrame" (geometry, fill colour/tint, stroke,
 *    opacity), so a background rectangle's colour can be read from the JSON.
 *  - Region frames can also sit on a master page (on the guide layer); they apply to every page using it.
 *  - For text regions, apply the paragraph/character style you want, and put sample text in the frame.
 *
 * Output: coordinates in mm (top-left origin, as shown in InDesign) and in PDF points (bottom-left
 * origin, ready for pdf-lib drawText/drawImage), both relative to the page's top-left corner.
 */

const {
  app,
  ColorSpace,
  Justification,
  Capitalization,
  Leading,
  MeasurementUnits,
  PageSideOptions
} = require("indesign");
const { storage } = require("uxp");
const fs = storage.localFileSystem;

const GUIDE_LAYER = "DYNAMIC_LAYER";
const MM_TO_PT = 72 / 25.4;
const templateRe = /^\s*template\s*[:.=]\s*(\S+)\s*$/i;

function round(n, places) {
  const f = Math.pow(10, places);
  return Math.round(n * f) / f;
}

function hex2(n) {
  const s = Math.max(0, Math.min(255, Math.round(n))).toString(16);
  return s.length === 1 ? "0" + s : s;
}

function colorInfo(c) {
  if (!c || !c.isValid) return null;
  try {
    const v = Array.from(c.colorValue);
    const out = { name: c.name, space: String(c.space), value: v };
    if (c.space === ColorSpace.RGB) {
      out.hex = "#" + hex2(v[0]) + hex2(v[1]) + hex2(v[2]);
    } else if (c.space === ColorSpace.CMYK) {
      // Naive conversion; use the CMYK values if the exact brand colour matters.
      const k = 1 - v[3] / 100;
      out.hex = "#" + hex2(255 * (1 - v[0] / 100) * k) + hex2(255 * (1 - v[1] / 100) * k) + hex2(255 * (1 - v[2] / 100) * k);
    }
    return out;
  } catch (e) {
    return { name: c.name };
  }
}

function justificationName(j) {
  if (j === Justification.CENTER_ALIGN) return "center";
  if (j === Justification.RIGHT_ALIGN) return "right";
  if (j === Justification.LEFT_ALIGN) return "left";
  if (j === Justification.FULLY_JUSTIFIED) return "justify";
  return String(j);
}

function textStyle(para) {
  const style = {};
  try { style.paragraphStyle = para.appliedParagraphStyle.name; } catch (e) {}
  try {
    style.fontFamily = para.appliedFont.fontFamily;
    style.fontStyle = para.fontStyle;
    style.postscriptName = para.appliedFont.postscriptName;
    style.fontFile = String(para.appliedFont.location || "");
  } catch (e) {}
  try {
    style.sizePt = round(para.pointSize, 2);
    style.leadingPt = para.leading === Leading.AUTO ? round(para.pointSize * (para.autoLeading / 100), 2) : round(para.leading, 2);
    style.trackingThousandthsEm = para.tracking;
    style.align = justificationName(para.justification);
    style.allCaps = para.capitalization === Capitalization.ALL_CAPS;
  } catch (e) {}
  try { style.color = colorInfo(para.fillColor); } catch (e) {}
  return style;
}

function regionFor(item, pageBounds, pageHeightMm) {
  const gb = item.geometricBounds; // [top, left, bottom, right] in current ruler units (mm)
  const x = gb[1] - pageBounds[1];
  const y = gb[0] - pageBounds[0];
  const w = gb[3] - gb[1];
  const h = gb[2] - gb[0];
  const region = {
    x: round(x, 3),
    y: round(y, 3),
    width: round(w, 3),
    height: round(h, 3),
    pdf: {
      x: round(x * MM_TO_PT, 2),
      y: round((pageHeightMm - y - h) * MM_TO_PT, 2),
      width: round(w * MM_TO_PT, 2),
      height: round(h * MM_TO_PT, 2)
    }
  };
  if (item.constructor.name === "TextFrame") {
    try {
      const contents = String(item.contents);
      if (item.paragraphs.length > 0 && contents !== "") {
        region.text = textStyle(item.paragraphs.item(0));
        region.sampleText = contents.substring(0, 80);
      }
      region.insetsMm = Array.from(item.textFramePreferences.insetSpacing);
      region.verticalAlign = String(item.textFramePreferences.verticalJustification);
    } catch (e) {}
  }
  return region;
}

// The template marker frame often doubles as the page background (e.g. a full-page coloured rectangle).
function templateFrameInfo(item, page, pageHeightMm) {
  const info = regionFor(item, page.bounds, pageHeightMm);
  info.type = item.constructor.name;
  try { info.fill = colorInfo(item.fillColor); } catch (e) {}
  try { if (item.fillTint >= 0) info.fillTintPercent = item.fillTint; } catch (e) {}
  try {
    info.stroke = item.strokeWeight > 0 ? colorInfo(item.strokeColor) : null;
    info.strokeWeightPt = item.strokeWeight;
  } catch (e) {}
  try { info.opacityPercent = item.transparencySettings.blendingSettings.opacity; } catch (e) {}
  try { info.cornerRadiusMm = item.topLeftCornerRadius; } catch (e) {}
  info.printing = item.nonprinting !== true;
  return info;
}

function parentPageOf(item) {
  try {
    const p = item.parentPage;
    return p && p.isValid !== false ? p : null;
  } catch (e) {
    return null;
  }
}

function buildResult(doc) {
  const result = {
    source: doc.name,
    exportedAt: new Date().toString(),
    units: { mm: "top-left origin, relative to page", pdf: "points, bottom-left origin, relative to page" },
    pages: []
  };
  const warnings = [];
  const pageMap = {};
  const layer = doc.layers.itemByName(GUIDE_LAYER);
  const items = Array.from(layer.allPageItems);
  const docPages = Array.from(doc.pages);

  docPages.forEach((p, i) => {
    const pb = p.bounds;
    const entry = {
      pageIndex: i,
      pageName: p.name,
      template: "page-" + (i + 1),
      widthMm: round(pb[3] - pb[1], 3),
      heightMm: round(pb[2] - pb[0], 3),
      regions: {}
    };
    entry.widthPt = round(entry.widthMm * MM_TO_PT, 2);
    entry.heightPt = round(entry.heightMm * MM_TO_PT, 2);
    result.pages.push(entry);
    pageMap[p.id] = entry;
  });

  const docTemplate = doc.name.replace(/\.indd$/i, "").toLowerCase();
  const masterOf = {}; // document page id -> the master page it uses
  const masterItems = {}; // master page id -> [{ item, label }]

  for (const dp of docPages) {
    try {
      const am = dp.appliedMaster;
      if (am && am.isValid && am.pages.length > 0) {
        masterOf[dp.id] = am.pages.length === 1
          ? am.pages.item(0)
          : (dp.side === PageSideOptions.LEFT_HAND ? am.pages.item(0) : am.pages.item(am.pages.length - 1));
      }
    } catch (e) {}
  }

  for (const ms of Array.from(doc.masterSpreads)) {
    for (const mi of Array.from(ms.allPageItems)) {
      const ml = mi.label;
      if (!ml) continue;
      const mpage = parentPageOf(mi);
      if (!mpage) continue;
      (masterItems[mpage.id] = masterItems[mpage.id] || []).push({ item: mi, label: ml });
    }
  }

  // Template: label on the page, else label on its master page, else the file name.
  for (const it of Array.from(doc.allPageItems)) {
    const tl = it.label;
    if (!tl) continue;
    const tm = templateRe.exec(tl);
    if (!tm) continue;
    const tpage = parentPageOf(it);
    if (tpage && pageMap[tpage.id]) {
      const e = pageMap[tpage.id];
      e.template = tm[1].toLowerCase();
      e.templateFrom = "label";
      e.templateFrame = templateFrameInfo(it, tpage, e.heightMm);
    }
  }
  for (const dp of docPages) {
    const te = pageMap[dp.id];
    const mlist = masterOf[dp.id] ? masterItems[masterOf[dp.id].id] : null;
    if (!te.templateFrom && mlist) {
      for (const entry of mlist) {
        const mt = templateRe.exec(entry.label);
        if (mt) {
          te.template = mt[1].toLowerCase();
          te.templateFrom = "master page label";
          te.templateFrame = templateFrameInfo(entry.item, masterOf[dp.id], te.heightMm);
          break;
        }
      }
    }
    // A document named Cover/Content/Back with no template label falls back to its file name.
    if (!te.templateFrom && docPages.length === 1 && /^(cover|content|back)$/.test(docTemplate)) {
      te.template = docTemplate;
      te.templateFrom = "file name";
    }
    if (!te.templateFrom) {
      warnings.push("Page " + te.pageName + ' has no template label (use e.g. "template:cover")');
    }
  }

  function addRegion(item, label, page, pageEntry, fromMaster) {
    const dot = label.indexOf(".");
    if (dot < 0) {
      const existing = pageEntry.regions[label];
      if (fromMaster && existing && !existing.children) return;
      const region = regionFor(item, page.bounds, pageEntry.heightMm);
      if (existing && existing.children) {
        region.children = existing.children;
      } else if (existing) {
        warnings.push("Duplicate label " + label + " on " + page.name);
      }
      pageEntry.regions[label] = region;
    } else {
      const parent = label.substring(0, dot);
      const child = label.substring(dot + 1);
      if (!pageEntry.regions[parent]) pageEntry.regions[parent] = {};
      if (!pageEntry.regions[parent].children) pageEntry.regions[parent].children = {};
      if (fromMaster && pageEntry.regions[parent].children[child]) return;
      pageEntry.regions[parent].children[child] = regionFor(item, page.bounds, pageEntry.heightMm);
    }
  }

  for (const item of items) {
    const label = item.label;
    if (!label) continue;
    if (templateRe.test(label)) continue;
    const page = parentPageOf(item);
    if (!page || !pageMap[page.id]) {
      warnings.push('"' + label + '" is not on a document page (pasteboard?) - skipped');
      continue;
    }
    addRegion(item, label, page, pageMap[page.id], false);
  }

  // Region frames placed on a master page apply to every page that uses it.
  for (const dp of docPages) {
    const mlist = masterOf[dp.id] ? masterItems[masterOf[dp.id].id] : null;
    if (!mlist) continue;
    for (const mi of mlist) {
      if (templateRe.test(mi.label)) continue;
      let onGuideLayer = false;
      try { onGuideLayer = mi.item.itemLayer.name === GUIDE_LAYER; } catch (e) {}
      if (!onGuideLayer) continue;
      addRegion(mi.item, mi.label, masterOf[dp.id], pageMap[dp.id], true);
    }
  }

  const REQUIRED = {
    cover: ["productDescription", "productPartNumber", "productHero"],
    content: ["cell"]
  };
  for (const pg of result.pages) {
    if (Object.keys(pg.regions).length === 0 && pg.template !== "back") {
      warnings.push("No labelled regions on page " + pg.pageName);
    }

    // Flatten cell.N children into an ordered array for the grid layout.
    if (pg.regions.cell && pg.regions.cell.children) {
      const cells = [];
      for (let c = 1; pg.regions.cell.children[String(c)]; c++) cells.push(pg.regions.cell.children[String(c)]);
      pg.cells = cells;
      delete pg.regions.cell;
      if (pg.template === "content" && cells.length !== 4) {
        warnings.push("Content page " + pg.pageName + " has " + cells.length + " cells (expected 4: cell.1 ... cell.4)");
      }
    }

    for (const req of REQUIRED[pg.template] || []) {
      const present = req === "cell" ? pg.cells && pg.cells.length : pg.regions[req];
      if (!present) warnings.push("Template " + pg.template + " (page " + pg.pageName + ") is missing " + req);
    }
  }
  if (warnings.length) result.warnings = warnings;
  return { result, warnings };
}

// Save next to the document when possible, otherwise ask where to save.
async function writeJson(doc, text) {
  let path = null;
  try {
    const full = String(doc.fullName);
    if (full && !/^untitled/i.test(full)) path = full.replace(/\.indd$/i, "") + ".regions.json";
  } catch (e) {}

  if (path) {
    try {
      const folderPath = path.replace(/[\\/][^\\/]*$/, "");
      const name = path.substring(folderPath.length + 1);
      const folder = await fs.getEntryWithUrl("file:" + folderPath.replace(/\\/g, "/"));
      const file = await folder.createFile(name, { overwrite: true });
      await file.write(text, { format: storage.formats.utf8 });
      return file.nativePath || path;
    } catch (e) {
      // Fall through to the save dialog (e.g. folder not permitted for this plugin).
    }
  }
  const file = await fs.getFileForSaving("brochure.regions.json", { types: ["json"] });
  if (!file) return null;
  await file.write(text, { format: storage.formats.utf8 });
  return file.nativePath;
}

async function main() {
  if (app.documents.length === 0) {
    await app.alert("Open the brochure scaffold first.");
    return;
  }
  const doc = app.activeDocument;
  if (!doc.layers.itemByName(GUIDE_LAYER).isValid) {
    await app.alert('Layer "' + GUIDE_LAYER + '" not found.');
    return;
  }

  const vp = doc.viewPreferences;
  const oldH = vp.horizontalMeasurementUnits;
  const oldV = vp.verticalMeasurementUnits;
  vp.horizontalMeasurementUnits = MeasurementUnits.MILLIMETERS;
  vp.verticalMeasurementUnits = MeasurementUnits.MILLIMETERS;

  let built;
  try {
    built = buildResult(doc);
  } finally {
    vp.horizontalMeasurementUnits = oldH;
    vp.verticalMeasurementUnits = oldV;
  }

  const target = await writeJson(doc, JSON.stringify(built.result, null, 2));
  if (!target) return;
  await app.alert("Wrote " + target + (built.warnings.length ? "\n\nWarnings:\n- " + built.warnings.join("\n- ") : ""));
}

main().catch(async (e) => {
  await app.alert("Export failed: " + (e && e.message ? e.message : e));
});
